# =====================================================================
#  WebAPI デモ 環境変数
#  - ローカルモード: make bootstrap が Supabase CLI の値を自動で書き込む
#  - クラウドモード: 下の「クラウドモード」の値に書き換えて make db-init seed
# =====================================================================
APP_MODE=local
API_BASE_URL=http://localhost:8000

# --- PostgreSQL ------------------------------------------------------
# ローカル: Supabase CLI（make env-sync で自動設定）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_STATEMENT_CACHE_SIZE=100
# クラウド（Supabase）: Session pooler か Direct connection を推奨
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler（:6543）を使う場合は prepared statement が使えないため 0 にする
#   DB_STATEMENT_CACHE_SIZE=0

# --- MongoDB ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=webapi_demo
# クラウド（Atlas）: Network Access の IP 許可リストに接続元を追加しておく
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Supabase Auth ---------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256（レガシー共有鍵）で署名されたトークンを検証する場合のみ必要。
# 非対称鍵（ES256 / RS256）の場合は JWKS から公開鍵を取得するため不要
SUPABASE_JWT_SECRET=

# --- 4-4 下流サービス（Toxiproxy 経由） -------------------------------
INVENTORY_UPSTREAM_URL=http://localhost:18000

# --- 5-3 OpenTelemetry ----------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- デモ ------------------------------------------------------------
DEMO_PASSWORD=Passw0rd!demo
ENABLE_VULN_ENDPOINTS=true
SEED_ORDERS=1000000
SEED_PRODUCTS=100000
